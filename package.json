{
  "name": "prezentoskop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "import:feed": "node --experimental-strip-types --no-warnings --env-file-if-exists=.env.local scripts/import-feed.ts",
    "check:services": "node --experimental-strip-types --no-warnings --env-file-if-exists=.env.local scripts/check-services.ts",
    "test:catalog": "node --experimental-strip-types --no-warnings scripts/test-catalog.ts",
    "test:pool": "node --experimental-strip-types --no-warnings scripts/test-pool.ts",
    "test:warmup": "node --experimental-strip-types --no-warnings scripts/test-warmup.ts",
    "test:cards": "node --experimental-strip-types --no-warnings scripts/test-cards.ts",
    "test:security": "node --experimental-strip-types --no-warnings scripts/test-security.ts",
    "catalog:verify": "node --experimental-strip-types --no-warnings --env-file-if-exists=.env.local scripts/catalog-verify.ts",
    "catalog:check": "npm run catalog:verify --",
    "catalog:warmup": "node --experimental-strip-types --no-warnings --env-file-if-exists=.env.local scripts/catalog-warmup.ts",
    "catalog:nightly": "node --experimental-strip-types --no-warnings --env-file-if-exists=.env.local scripts/catalog-nightly.ts",
    "catalog:build": "node --experimental-strip-types --no-warnings --env-file-if-exists=.env.local scripts/catalog-nightly.ts --steps build",
    "catalog:tag": "node --experimental-strip-types --no-warnings --env-file-if-exists=.env.local scripts/catalog-nightly.ts --steps tag",
    "test:ai": "node --experimental-strip-types --no-warnings --env-file-if-exists=.env.test-ai scripts/test-ai.ts",
    "test:prompts": "node --experimental-strip-types --no-warnings --env-file-if-exists=.env.local scripts/test-prompts.ts",
    "guides:refresh": "node --experimental-strip-types --no-warnings --env-file-if-exists=.env.local scripts/refresh-guides.ts",
    "edge:sync": "node scripts/sync-edge.mjs",
    "edge:deploy": "node scripts/sync-edge.mjs && supabase functions deploy run-search --no-verify-jwt && supabase functions deploy check-links --no-verify-jwt",
    "seed":"node --experimental-strip-types --no-warnings --env-file-if-exists=.env.local scripts/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/supabase-js": "^2.119.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.80.0",
    "next": "16.4.6",
    "posthog-js": "^1.454.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.39.0",
    "stripe": "^23.2.0",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
