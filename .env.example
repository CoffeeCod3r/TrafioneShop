# Copy to .env.local and fill in. Never commit .env.local.
# NEXT_PUBLIC_* values are bundled into the browser: only publishable/public keys go there.

# --- Mode ---
# true (default): demo mode – fake AI, payments (/demo-checkout), captcha and email,
# data in .data/demo-db.json. No service keys needed. Never allowed in production (VERCEL_ENV=production or Netlify CONTEXT=production).
# false: real services – every key below is required.
MOCK_MODE=true
# With MOCK_MODE=true you can still run single services for real (Supabase / Stripe Checkout).
# Needs the matching keys below; use Stripe TEST keys (sk_test_) and `stripe listen` for the webhook.
# Ignored when MOCK_MODE=false (everything is real). Never reaches production (MOCK_MODE=true is refused there).
REAL_DB=false
REAL_PAYMENTS=false

# --- App ---
# Production: https://prezentoskop.pl
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Free results ---
# web (default): the AI searches trusted Polish shops for the free result (runs in a Supabase Edge Function,
#                see supabase/functions/run-search). catalog: the AI picks from the partner catalog
#                (use after the affiliate networks accept the site).
SOURCE_MODE=web
# Daily AI spending cap in PLN (counted from ai_usage). Above it free results come from the catalog.
DAILY_AI_BUDGET_PLN=30
# Nightly pool job (npm run catalog:nightly, GitHub Actions): hard AI cost limit per night in USD, and the AI provider
# for the targeted top-up (anthropic | demo). Run it with REAL_DB=true to use the real database.
NIGHTLY_AI_BUDGET_USD=0.30
CATALOG_AI_PROVIDER=anthropic

# --- Payments ---
# false (default): paid offers are hidden ("już wkrótce"). An admin logged in at /admin can still test payments.
# true: everybody can buy.
PAYMENTS_ENABLED=false

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-
ANTHROPIC_MODEL=claude-haiku-5-5
# PLN per 1 USD, used to show AI costs in /admin
USD_PLN_RATE=4.00
# Per-call output token limit
AI_MAX_TOKENS=1024
# Paid search limits per run
PAID_SEARCH_MAX_SEARCHES=10
PAID_SEARCH_MAX_FETCHES=15

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
# Prices are sent inline with each Checkout Session (lib/offers.ts): no Price IDs needed.
# End of a pack promotion (ISO 8601). Only used when an offer in lib/offers.ts has a promoGrosze (today none has).
# Empty = built-in default (2026-11-27 23:59 Warsaw).
PROMO_ENDS_AT=

# --- Cloudflare Turnstile ---
# Local testing: Cloudflare test keys that always pass:
#   site key 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Resend ---
RESEND_API_KEY=re_
EMAIL_FROM="Prezentoskop <prezenty@example.pl>"

# --- PostHog ---
NEXT_PUBLIC_POSTHOG_KEY=phc_
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Internal ---
# Bearer token for Vercel Cron routes (min. 32 chars)
CRON_SECRET=
# Secret salt for hashing IPs in rate_limits (min. 32 chars). We never store raw IPs.
IP_HASH_SALT=
# Secret for signing newsletter confirm/unsubscribe links (min. 32 chars)
EMAIL_TOKEN_SECRET=
# Password for the /admin panel (min. 12 chars)
ADMIN_PASSWORD=
# Product feeds: whitespace-separated "network=url" entries (networks: awin, webepartners, gmc).
# Whitespace, not commas, because feed URLs can contain commas. Keep the quotes.
FEED_URLS="awin=https://productdata.awin.com/datafeed/download/apikey/XXX/... webepartners=https://example.com/feed.xml"

# --- Edge Function run-search (background web search) ---
# Deploy: npm run edge:deploy  (needs the Supabase CLI, linked project)
# Secrets: supabase secrets set ANTHROPIC_API_KEY=... SITE_URL=https://prezentoskop.pl CRON_SECRET=<same as CRON_SECRET above>
# (ANTHROPIC_MODEL is optional, default claude-haiku-5-5). Apply migration 20261122000000 first (supabase db push).
