# Copy to .env.local and fill in. Never commit .env.local.
# NEXT_PUBLIC_* values are bundled into the browser: only publishable/public keys go there.

# --- Mode ---
# true (default): demo mode â€“ fake AI, payments (/demo-checkout), captcha and email,
# data in .data/demo-db.json. No service keys needed. Never allowed when VERCEL_ENV=production.
# false: real services â€“ every key below is required.
MOCK_MODE=true

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# PLN per 1 USD, used to show AI costs in /admin
USD_PLN_RATE=4.00
# Per-call output token limit
AI_MAX_TOKENS=1024
# Paid search limits per run
PAID_SEARCH_MAX_SEARCHES=5
PAID_SEARCH_MAX_FETCHES=15

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs for the A/B test (4.99 PLN and 9.99 PLN)
STRIPE_PRICE_ID_A=
STRIPE_PRICE_ID_B=


NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Cloudflare Turnstile ---
# Local testing: Cloudflare test keys that always pass:
#   site key 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Resend ---
RESEND_API_KEY=
EMAIL_FROM="Prezentoskop <prezenty@example.pl>"

# --- PostHog ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Internal ---
# Generate each secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER put real values in this file: the repository is public.
# Bearer token for Vercel Cron routes (min. 32 chars)
CRON_SECRET=
# Secret salt for hashing IPs in rate_limits (min. 32 chars). We never store raw IPs.
IP_HASH_SALT=
# Secret for signing newsletter confirm/unsubscribe links (min. 32 chars)
EMAIL_TOKEN_SECRET=
# Password for the /admin panel (min. 12 chars)
ADMIN_PASSWORD=
# Key for signing the /admin session cookie (min. 32 chars). Without it the session is signed with a key derived from ADMIN_PASSWORD.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
# Product feeds: whitespace-separated "network=url" entries (networks: awin, webepartners, gmc).
# Whitespace, not commas, because feed URLs can contain commas. Keep the quotes.
FEED_URLS="awin=https://productdata.awin.com/datafeed/download/apikey/XXX/... webepartners=https://example.com/feed.xml"

REAL_DB=true
REAL_PAYMENTS=true

# Product pool (scripts/catalog-nightly.ts, GitHub Actions nightly-catalog.yml)
# Hard AI cost limit of one night, in USD.
NIGHTLY_AI_BUDGET_USD=0.30
# Only anthropic is supported.
CATALOG_AI_PROVIDER=anthropic
# true = free results use only active products checked in the last 7 days (turn on after the pool was checked).
POOL_STRICT=false
