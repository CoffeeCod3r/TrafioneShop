# Copy to .env.local and fill in. Never commit .env.local.
# NEXT_PUBLIC_* values are bundled into the browser: only publishable/public keys go there.

# --- Mode ---
# true (default): demo mode â€“ fake AI, payments (/demo-checkout), captcha and email,
# data in .data/demo-db.json. No service keys needed. Never allowed when VERCEL_ENV=production.
# false: real services â€“ every key below is required.
MOCK_MODE=true

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://sdnleotwibrtyxodhewi.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_uSZnRWsY-6fDrT4uoD78oA_cRxFKkFr
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_uSZnRWsY-6fDrT4uoD78oA_cRxFKkFr
# Server only. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_Yw5T7d750TzdDVkNwXW3Fg_44olM8P7

# --- Anthropic ---
ANTHROPIC_API_KEY=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
ANTHROPIC_MODEL=claude-haiku-5-5
# PLN per 1 USD, used to show AI costs in /admin
