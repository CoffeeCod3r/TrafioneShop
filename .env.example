# Copy to .env.local and fill in. Never commit .env.local.
# NEXT_PUBLIC_* values are bundled into the browser: only publishable/public keys go there.

# --- Mode ---
# true (default): demo mode – fake AI, payments (/demo-checkout), captcha and email,
# data in .data/demo-db.json. No service keys needed. Never allowed when VERCEL_ENV=production.
# false: real services – every key below is required.
MOCK_MODE=true

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://sdnleotwibrtyxodhewi.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_uSZnRWsY-6fDrT4uoD78oA_cRxFKkFr
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_uSZnRWsY-6fDrT4uoD78oA_cRxFKkFr
# Server only. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_nT5D3T92oRPa7yiMJwIW0w_JbufHP70

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-
ANTHROPIC_MODEL=claude-haiku-5-5
# PLN per 1 USD, used to show AI costs in /admin
USD_PLN_RATE=4.00
# Per-call output token limit
AI_MAX_TOKENS=1024
# Paid search limits per run
PAID_SEARCH_MAX_SEARCHES=5
PAID_SEARCH_MAX_FETCHES=15

# --- Stripe ---
STRIPE_SECRET_KEY=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
STRIPE_WEBHOOK_SECRET=whsec_
# Price IDs for the A/B test (4.99 PLN and 9.99 PLN)
STRIPE_PRICE_ID_A=price_
STRIPE_PRICE_ID_B=price_

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_51RBhFYH2AmFVvS3gKOxZFjSdbuFxgjvxmKYjyShDTjPpKNzrqQv7UnhsetSFmCt91QEj0QTGDbJDy0yIbAiwlO0c00hDuMbftM

# --- Cloudflare Turnstile ---
# Local testing: Cloudflare test keys that always pass:
#   site key 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Resend ---
RESEND_API_KEY=re_
EMAIL_FROM="Prezentownik AI <prezenty@example.pl>"

# --- PostHog ---
NEXT_PUBLIC_POSTHOG_KEY=phc_
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Internal ---
# Bearer token for Vercel Cron routes (min. 32 chars)
CRON_SECRET=
# Secret salt for hashing IPs in rate_limits (min. 32 chars). We never store raw IPs.
IP_HASH_SALT=
# Secret for signing newsletter confirm/unsubscribe links (min. 32 chars)
EMAIL_TOKEN_SECRET=
# Password for the /admin panel (min. 12 chars)
ADMIN_PASSWORD=
# Product feeds: whitespace-separated "network=url" entries (networks: awin, webepartners, gmc).
# Whitespace, not commas, because feed URLs can contain commas. Keep the quotes.
FEED_URLS="awin=https://productdata.awin.com/datafeed/download/apikey/XXX/... webepartners=https://example.com/feed.xml"
