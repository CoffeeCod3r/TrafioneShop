# Copy to .env.test-ai (git-ignored) and fill in. Used only by `npm run test:ai` (scripts/test-ai.ts), which starts
# a local `next dev` with these values. Never commit real keys.

# Everything real, except Stripe in TEST mode and Cloudflare Turnstile TEST keys.
MOCK_MODE=false
SOURCE_MODE=web
PAYMENTS_ENABLED=true
NEXT_PUBLIC_SITE_URL=http://localhost:3210

# Supabase (the production project: test data is marked source=test:ai and deleted at the end)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (real calls: about 3 USD per full run)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Stripe TEST mode only (sk_test_..., whsec_... of a test webhook endpoint or `stripe listen`)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare Turnstile official TEST keys (always pass), from Cloudflare's Turnstile testing documentation
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# The same values as the app (see .env.example): needed by the server and the Edge Function callbacks
CRON_SECRET=
IP_HASH_SALT=
EMAIL_TOKEN_SECRET=
ADMIN_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=
USD_PLN_RATE=4
